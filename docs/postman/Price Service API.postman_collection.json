          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "const body = pm.response.json();",
              "pm.test('Problem details', () => {",
              "    pm.expect(body.status).to.eql(404);",
              "    pm.expect(body.title).to.eql('Not Found');",
              "    pm.expect(body.detail).to.be.a('string');",
              "});"
            ]
          }
