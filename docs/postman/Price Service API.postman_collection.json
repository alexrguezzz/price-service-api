{
  "info": {
    "name": "Price Service API",
    "description": "Five exercise scenarios and representative client errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Exercise 1 - June 14 at 10:00",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/prices?applicationDate=2020-06-14T10:00:00&productId=35455&brandId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "prices"
          ],
          "query": [
            {
              "key": "applicationDate",
              "value": "2020-06-14T10:00:00"
            },
            {
              "key": "productId",
              "value": "35455"
            },
            {
              "key": "brandId",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Selected price and response fields', () => {",
              "    pm.expect(body.productId).to.eql(35455);",
              "    pm.expect(body.brandId).to.eql(1);",
              "    pm.expect(body.priceListId).to.eql(1);",
              "    pm.expect(body.startDate).to.eql('2020-06-14T00:00:00');",
              "    pm.expect(body.endDate).to.eql('2020-12-31T23:59:59');",
              "    pm.expect(body.price).to.eql(35.5);",
              "    pm.expect(body.currency).to.eql('EUR');",
              "    pm.expect(body).to.not.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
